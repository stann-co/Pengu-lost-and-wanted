}
[file = window_command_hook.gml, start_fn = window_command_hook_init]
group {
    [global, bind = gmval, overwrite]
    function window_command_hook_init() : real;

    [global, bind = gmval, overwrite]
    function window_command_hook_prepare_buffer(arg0 : real) : real;

}
[file = autogen.gml]
group {

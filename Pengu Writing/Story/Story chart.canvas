		{"id":"277538349efd43d0","type":"text","text":"Escapes cell and goes to the main city","x":-780,"y":43,"width":250,"height":60},
		{"id":"eb11d0c249d585f3","type":"text","text":"they become friends, and he goes with her","x":-480,"y":133,"width":250,"height":60},
